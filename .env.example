# Copy to .env and fill only the keys you have. .env is gitignored.
# Values are the raw token. Do not add Bearer, hf_, or any other prefix.
# Commented lines stay unset. ./test.sh still clears these before the CI suite.

HF_TOKEN=
XAI_API_KEY=

