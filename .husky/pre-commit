#!/bin/sh

# Local stand-in for GitHub CI (which runs once daily at 06:00 CET).
# Get list of staged files before running check
STAGED_FILES=$(git diff --cached --name-only)

node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# Run the check script (formatting, linting, and type checking)
echo "Running formatting, linting, and type checking..."
npm run check
if [ $? -ne 0 ]; then
  echo "Checks failed. Fix the errors before committing."
  exit 1
fi

RUN_BROWSER_SMOKE=0
CODE_STAGED=0
for file in $STAGED_FILES; do
  case "$file" in
    packages/ai/*|packages/web-ui/*|package.json|package-lock.json)
      RUN_BROWSER_SMOKE=1
      ;;
  esac
  case "$file" in
    *.md|*.mdx)
      ;;
    *)
      CODE_STAGED=1
      ;;
  esac
done

if [ $RUN_BROWSER_SMOKE -eq 1 ]; then
  echo "Running browser smoke check..."
  npm run check:browser-smoke
  if [ $? -ne 0 ]; then
    echo "Browser smoke check failed."
    exit 1
  fi
fi

# Restage files that were previously staged and may have been modified by formatting
for file in $STAGED_FILES; do
  if [ -f "$file" ]; then
    git add "$file"
  fi
done

if [ $CODE_STAGED -eq 1 ]; then
  echo "Running tests affected by staged files (GitHub CI is the daily full suite)..."
  ./test.sh --affected
  if [ $? -ne 0 ]; then
    echo "Tests failed. Fix them before committing."
    exit 1
  fi
fi

echo "All pre-commit checks passed."
